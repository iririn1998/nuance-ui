{
  "name": "neumorph-ui",
  "version": "0.1.0",
  "description": "A neumorphism-inspired UI component library built on top of Mantine",
  "license": "MIT",
  "author": "iririn <iririn199810710@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iririn1998/neumorph-ui.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/iririn1998/neumorph-ui#readme",
  "bugs": {
    "url": "https://github.com/iririn1998/neumorph-ui/issues"
  },
  "keywords": [
    "react",
    "mantine",
    "neumorphism",
    "neumorphic",
    "ui",
    "components",
    "design-system",
    "theme"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:storybook": "vitest run --config vitest.storybook.config.mts",
    "test:storybook:watch": "vitest --config vitest.storybook.config.mts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt -c node_modules/@neumorph-ui/config/src/oxfmt/base.json src",
    "fmt:check": "oxfmt -c node_modules/@neumorph-ui/config/src/oxfmt/base.json --check src",
    "lint": "NODE_OPTIONS='--experimental-strip-types --no-warnings' oxlint src",
    "lint:fix": "NODE_OPTIONS='--experimental-strip-types --no-warnings' oxlint src --fix"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@mantine/core": "^7.0.0",
    "@mantine/hooks": "^7.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@mantine/core": "catalog:",
    "@mantine/hooks": "catalog:",
    "@neumorph-ui/config": "workspace:*",
    "@storybook/experimental-addon-test": "catalog:",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/test": "^8.6.17",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "^2.1.0",
    "happy-dom": "catalog:",
    "jsdom": "^25.0.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "^1.49.0",
    "postcss": "^8.4.0",
    "postcss-preset-mantine": "^1.17.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tsdown": "^0.20.3",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
