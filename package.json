{
  "name": "neumorph-ui-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --filter neumorph-ui build",
    "dev": "pnpm --filter @neumorph-ui/storybook dev",
    "test": "pnpm --filter neumorph-ui test",
    "typecheck": "pnpm --filter neumorph-ui typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  }
}
